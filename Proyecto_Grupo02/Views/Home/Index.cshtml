@model Proyecto_Grupo02.Models.UsuarioModel

@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="row h-100">
    <div class="col-lg-5 col-12">
        <div id="auth-left">
            <div class="auth-logo">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/Content/images/KA FASHION BY KMONTES.png" alt="Logo">
                </a>
            </div>

            <h1 class="auth-title">
                <span class="auth-title-red">Iniciar</span> sesión
            </h1>
            <p class="auth-subtitle mb-5">Ingrese sus datos para poder acceder a la cuenta .</p>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger">@ViewBag.Mensaje</div>
            }

            @using (Html.BeginForm("Index", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group position-relative has-icon-left mb-4">
                    @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control form-control-xl", placeholder = "Correo electrónico" })
                    <div class="form-control-icon">
                        <i class="bi bi-person"></i>
                    </div>
                    @Html.ValidationMessageFor(m => m.CorreoElectronico, "", new { @class = "text-danger" })
                </div>

                <div class="form-group position-relative has-icon-left mb-4">
                    @Html.PasswordFor(m => m.Contrasenna, new { @class = "form-control form-control-xl", placeholder = "Contraseña" })
                    <div class="form-control-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg shadow-lg mt-5">
                    Iniciar sesión
                </button>
            }

            <div class="text-center mt-5 text-lg fs-4">
                <p class="text-gray-600">
                    ¿No tiene una cuenta?
                    <a href="@Url.Action("Registro", "Home")" class="font-bold">
                        Regístrate
                    </a>.
                </p>

                <p>
                    <a class="font-bold" href="@Url.Action("RecuperarAcceso", "Home")">
                        ¿Olvidó su contraseña?
                    </a>
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-7 d-none d-lg-block">
        <div id="auth-right"></div>
    </div>
</div>