@model Proyecto_Grupo02.Models.UsuarioModel
@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="row h-100">
    <div class="col-lg-5 col-12">
        <div id="auth-left">
            <div class="auth-logo">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/Content/images/KA FASHION BY KMONTES.png" alt="Logo">
                </a>
            </div>

            <h1 class="auth-title">¿Olvidaste tu contraseña?</h1>
            <p class="auth-subtitle mb-5">
                Ingresa tu correo electrónico y te enviaremos una contraseña temporal.
            </p>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger">@ViewBag.Mensaje</div>
            }
            @if (ViewBag.MensajeExito != null)
            {
                <div class="alert alert-success">@ViewBag.MensajeExito</div>
            }

            @using (Html.BeginForm("RecuperarAcceso", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group position-relative has-icon-left mb-4">
                    @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control form-control-xl", placeholder = "Correo electrónico" })
                    <div class="form-control-icon"><i class="bi bi-envelope"></i></div>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg shadow-lg mt-5">
                    Enviar contraseña temporal
                </button>
            }

            <div class="text-center mt-5 text-lg fs-4">
                <p class="text-gray-600">
                    ¿Te acordaste de tu contraseña?
                    <a href="@Url.Action("Index", "Home")" class="font-bold">Inicia sesión</a>.
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-7 d-none d-lg-block">
        <div id="auth-right"></div>
    </div>
</div>