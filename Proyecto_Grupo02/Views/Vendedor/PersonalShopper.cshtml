@model List<Proyecto_Grupo02.Models.VendedorPersonalShopperViewModel>

@{
    ViewBag.Title = "Personal Shopper";
    Layout = "~/Views/Shared/_LayoutVendedor.cshtml";
}


<div class="page-title">

    <h3>Solicitudes de Personal Shopper</h3>

    <p class="page-subtitle">
        Consulta y atiende las solicitudes enviadas por los clientes.
    </p>

</div>


@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">

        @TempData["MensajeExito"]

    </div>
}


<section class="section">

    <div class="ka-module-card">

        <div class="table-responsive">

            <table class="table">

                <thead>

                    <tr>

                        <th>Cliente</th>
                        <th>Estilo</th>
                        <th>Talla</th>
                        <th>Presupuesto</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acción</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @item.Cliente
                                </strong>

                                <br />

                                <small>
                                    @item.Correo
                                </small>

                            </td>


                            <td>
                                @item.EstiloBuscado
                            </td>


                            <td>
                                @item.Talla
                            </td>


                            <td>
                                @item.Presupuesto.ToString("₡#,##0.00")
                            </td>


                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy")
                            </td>


                            <td>

                                @if (item.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @item.Estado
                                    </span>
                                }

                            </td>


                            <td>

                                @if (item.Estado == "Pendiente")
                                {
                                    using (Html.BeginForm(
                                        "AtenderPersonalShopper",
                                        "Vendedor",
                                        FormMethod.Post))
                                    {
                                        @Html.Hidden(
                                                 "id",
                                                 item.IdSolicitud
                                             )

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">

                                            <i class="bi bi-check-circle"></i>

                                            Marcar atendida

                                        </button>
                                    }
                                }

                            </td>

                        </tr>


                        <tr>

                            <td colspan="7">

                                <small>
                                    <strong>
                                        Necesidades:
                                    </strong>

                                    @item.Necesidades
                                </small>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>