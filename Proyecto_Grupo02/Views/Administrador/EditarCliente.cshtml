@model Proyecto_Grupo02.Models.AdministradorClienteFormularioViewModel

@{
    ViewBag.Title = "Editar cliente";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}


<div class="page-title">

    <h3>Editar cliente</h3>

    <p class="page-subtitle">
        Modifica la información del cliente seleccionado.
    </p>

</div>


<section class="section">

    <div class="ka-module-card">

        <div class="mb-4">

            <span class="ka-module-label">
                Cliente
            </span>

            <h4 class="mt-2">
                Información del cliente
            </h4>

            <p class="text-muted">
                Modifica los datos necesarios y guarda los cambios.
            </p>

        </div>


        @using (Html.BeginForm(
            "EditarCliente",
            "Administrador",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(
                m => m.Consecutivo)


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Identificación
                    </label>

                    @Html.TextBoxFor(
                        m => m.Identificacion,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese la identificación"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Identificacion,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Nombre
                    </label>

                    @Html.TextBoxFor(
                        m => m.Nombre,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el nombre"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Nombre,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Primer apellido
                    </label>

                    @Html.TextBoxFor(
                        m => m.Apellido1,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el primer apellido"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Apellido1,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Segundo apellido
                    </label>

                    @Html.TextBoxFor(
                        m => m.Apellido2,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el segundo apellido"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Correo electrónico
                    </label>

                    @Html.TextBoxFor(
                        m => m.CorreoElectronico,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "correo@ejemplo.com"
                        })

                    @Html.ValidationMessageFor(
                        m => m.CorreoElectronico,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Teléfono
                    </label>

                    @Html.TextBoxFor(
                        m => m.Telefono,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ejemplo: 8888-8888"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label d-block">
                        Estado del cliente
                    </label>


                    <div class="form-check form-switch mt-2">

                        @Html.CheckBoxFor(
                            m => m.Estado,
                            new
                            {
                                @class = "form-check-input"
                            })

                        <label class="form-check-label">
                            Cliente activo
                        </label>

                    </div>


                    <small class="text-muted">
                        Si desactivas esta opción, el cliente no podrá iniciar sesión.
                    </small>

                </div>


                <div class="col-md-12 mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>

                        Guardar cambios

                    </button>


                    <a href="@Url.Action(
                                "Clientes",
                                "Administrador")"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-arrow-left"></i>

                        Cancelar

                    </a>

                </div>


            </div>
        }

    </div>

</section>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}