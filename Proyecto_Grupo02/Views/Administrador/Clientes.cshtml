@using System.Linq
@model IEnumerable<Proyecto_Grupo02.Models.AdministradorClienteViewModel>

@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}


<div class="page-title">

    <h3>Gestión de clientes</h3>

    <p class="page-subtitle">
        Consulta y administra los clientes registrados en KA Fashion.
    </p>

</div>


<section class="section">


    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <div class="ka-module-card">


        <div class="mb-4">

            <span class="ka-module-label">
                Clientes
            </span>

            <h4 class="mt-2 mb-0">
                Clientes registrados
            </h4>

            <p class="text-muted mt-2">
                Desde aquí puedes consultar, editar,
                activar o desactivar clientes.
            </p>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Identificación
                            </th>

                            <th>
                                Nombre
                            </th>

                            <th>
                                Correo electrónico
                            </th>

                            <th>
                                Teléfono
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var cliente in Model)
                        {
                            <tr>

                                
                                <td>

                                    @cliente.Identificacion

                                </td>


                                
                                <td>

                                    <strong>
                                        @cliente.NombreCompleto
                                    </strong>

                                </td>


                                
                                <td>

                                    @cliente.CorreoElectronico

                                </td>


                                
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                            cliente.Telefono))
                                    {
                                        @cliente.Telefono
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin teléfono
                                        </span>
                                    }

                                </td>


                                
                                <td>

                                    @if (cliente.Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>


                                
                                <td class="text-center">


                                   
                                    <a href="@Url.Action(
                                                "EditarCliente",
                                                "Administrador",
                                                new
                                                {
                                                    id = cliente.Consecutivo
                                                })"
                                       class="btn btn-sm btn-primary me-1">

                                        <i class="bi bi-pencil-square"></i>

                                        Editar

                                    </a>


                                   
                                    @if (cliente.Estado)
                                    {
                                        <a href="@Url.Action(
                                                    "CambiarEstadoCliente",
                                                    "Administrador",
                                                    new
                                                    {
                                                        id = cliente.Consecutivo
                                                    })"
                                           class="btn btn-sm btn-secondary"
                                           onclick="return confirm('¿Desea desactivar este cliente?');">

                                            <i class="bi bi-person-x-fill"></i>

                                            Desactivar

                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action(
                                                    "CambiarEstadoCliente",
                                                    "Administrador",
                                                    new
                                                    {
                                                        id = cliente.Consecutivo
                                                    })"
                                           class="btn btn-sm btn-success"
                                           onclick="return confirm('¿Desea activar este cliente?');">

                                            <i class="bi bi-person-check-fill"></i>

                                            Activar

                                        </a>
                                    }


                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-info">

                No hay clientes registrados actualmente.

            </div>
        }


    </div>

</section>