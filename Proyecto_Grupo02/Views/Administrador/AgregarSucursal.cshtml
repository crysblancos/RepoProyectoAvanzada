@model Proyecto_Grupo02.Models.AdministradorSucursalFormularioViewModel

@{
    ViewBag.Title = "Agregar sucursal";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}


<div class="page-title">

    <h3>Agregar sucursal</h3>

    <p class="page-subtitle">
        Registra una nueva sucursal de KA Fashion.
    </p>

</div>


<section class="section">

    <div class="ka-module-card">

        <div class="mb-4">

            <span class="ka-module-label">
                Nueva sucursal
            </span>

            <h4 class="mt-2">
                Información de la sucursal
            </h4>

        </div>


        @using (Html.BeginForm(
            "AgregarSucursal",
            "Administrador",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Nombre
                    </label>

                    @Html.TextBoxFor(
                        m => m.Nombre,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el nombre de la sucursal"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Nombre,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Teléfono
                    </label>

                    @Html.TextBoxFor(
                        m => m.Telefono,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ejemplo: 2222-2222"
                        })

                </div>


                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Dirección
                    </label>

                    @Html.TextAreaFor(
                        m => m.Direccion,
                        new
                        {
                            @class = "form-control",
                            rows = "3",
                            placeholder = "Ingrese la dirección"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Direccion,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-8 mb-3">

                    <label class="form-label">
                        Horario
                    </label>

                    @Html.TextBoxFor(
                        m => m.Horario,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ejemplo: Lunes a sábado 9:00 a.m. - 6:00 p.m."
                        })

                </div>


                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Estado
                    </label>

                    @Html.DropDownListFor(
                        m => m.IdEstado,
                        Model.Estados,
                        "Seleccione un estado",
                        new
                        {
                            @class = "form-select"
                        })

                </div>


                <div class="col-md-12 mt-3">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>

                        Guardar sucursal

                    </button>


                    <a href="@Url.Action(
                                "Sucursales",
                                "Administrador")"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-arrow-left"></i>

                        Cancelar

                    </a>

                </div>

            </div>
        }

    </div>

</section>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}