@model Proyecto_Grupo02.Models.AdministradorCategoriaFormularioViewModel

@{
    ViewBag.Title = "Agregar categoría";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}


<div class="page-title">

    <h3>Agregar categoría</h3>

    <p class="page-subtitle">
        Registra una nueva categoría para los productos.
    </p>

</div>


<section class="section">

    <div class="ka-module-card">

        <div class="mb-4">

            <span class="ka-module-label">
                Nueva categoría
            </span>

            <h4 class="mt-2">
                Información de la categoría
            </h4>

        </div>


        @using (Html.BeginForm(
            "AgregarCategoria",
            "Administrador",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()


            <div class="row">


                <div class="col-md-8 mb-3">

                    <label class="form-label">
                        Nombre
                    </label>

                    @Html.TextBoxFor(
                        m => m.Nombre,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese el nombre de la categoría"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Nombre,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Estado
                    </label>

                    @Html.DropDownListFor(
                        m => m.IdEstado,
                        Model.Estados,
                        "Seleccione un estado",
                        new
                        {
                            @class = "form-select"
                        })

                    @Html.ValidationMessageFor(
                        m => m.IdEstado,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Descripción
                    </label>

                    @Html.TextAreaFor(
                        m => m.Descripcion,
                        new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Ingrese una descripción"
                        })

                </div>


                <div class="col-md-12 mt-3">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>

                        Guardar categoría

                    </button>


                    <a href="@Url.Action(
                                "Categorias",
                                "Administrador")"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-arrow-left"></i>

                        Cancelar

                    </a>

                </div>


            </div>
        }

    </div>

</section>


@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}