@using System.Linq
@model IEnumerable<Proyecto_Grupo02.Models.AdministradorPedidoViewModel>

@{
    ViewBag.Title = "Pedidos";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}


<div class="page-title">

    <h3>Gestión de pedidos</h3>

    <p class="page-subtitle">
        Consulta los pedidos realizados por los clientes de KA Fashion.
    </p>

</div>


<section class="section">

    <div class="ka-module-card">

        <div class="mb-4">

            <span class="ka-module-label">
                Pedidos
            </span>

            <h4 class="mt-2 mb-0">
                Pedidos realizados
            </h4>

            <p class="text-muted mt-2">
                Desde aquí puedes consultar el detalle de cada pedido.
            </p>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Método de entrega</th>
                            <th>Sucursal</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var pedido in Model)
                        {
                            <tr>

                                <td>
                                    <strong>#@pedido.IdPedido</strong>
                                </td>

                                <td>
                                    @pedido.Cliente
                                </td>

                                <td>
                                    @pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @pedido.MetodoEntrega
                                </td>

                                <td>
                                    @pedido.Sucursal
                                </td>

                                <td>
                                    @pedido.Total.ToString("₡#,##0.00")
                                </td>

                                <td>

                                    @if (pedido.Estado == "Activo")
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@pedido.Estado</span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a href="@Url.Action("DetallePedido", "Administrador", new { id = pedido.IdPedido })"
                                       class="btn btn-sm btn-primary">

                                        <i class="bi bi-eye-fill"></i>
                                        Ver detalle

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-info">
                No hay pedidos registrados actualmente.
            </div>
        }

    </div>

</section>
