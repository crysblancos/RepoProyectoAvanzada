@model Proyecto_Grupo02.Models.ContactoModel
@{
    ViewBag.Title = "Contacto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-7">
    <div class="ka-form-container">
        <div class="ka-form-introduction">
            <span class="ka-module-label">Formulario de contacto</span>
            <h4>Escríbenos</h4>
            <p>Completa los datos y describe tu consulta.</p>
        </div>

        @if (ViewBag.MensajeExito != null)
        {
            <div class="alert alert-success">@ViewBag.MensajeExito</div>
        }
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger">@ViewBag.Mensaje</div>
        }

        @using (Html.BeginForm("Contacto", "Contacto", FormMethod.Post, new { id = "formContacto" }))
        {
            <div class="row">
                <div class="col-md-6 mb-4">
                    @Html.LabelFor(m => m.Nombre, "Nombre completo *", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control ka-form-control", id = "contactoNombre" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "invalid-feedback d-block" })
                </div>

                <div class="col-md-6 mb-4">
                    @Html.LabelFor(m => m.Correo, "Correo electrónico *", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-control ka-form-control", id = "contactoCorreo", type = "email" })
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "invalid-feedback d-block" })
                </div>

                <div class="col-md-6 mb-4">
                    @Html.LabelFor(m => m.Asunto, "Asunto *", new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Asunto, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Seleccione un asunto", Value = "" },
                        new SelectListItem { Text = "Consulta de productos", Value = "Productos" },
                        new SelectListItem { Text = "Consulta de pedidos", Value = "Pedidos" },
                        new SelectListItem { Text = "Consulta de sucursales", Value = "Sucursales" },
                        new SelectListItem { Text = "Personal Shopper", Value = "Personal Shopper" },
                        new SelectListItem { Text = "Otro", Value = "Otro" }
                    }, new { @class = "form-select ka-form-control", id = "contactoAsunto" })
                    @Html.ValidationMessageFor(m => m.Asunto, "", new { @class = "invalid-feedback d-block" })
                </div>

                <div class="col-12 mb-4">
                    @Html.LabelFor(m => m.Mensaje, "Mensaje *", new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.Mensaje, new { @class = "form-control ka-form-control", id = "contactoMensaje", rows = 6 })
                    @Html.ValidationMessageFor(m => m.Mensaje, "", new { @class = "invalid-feedback d-block" })
                </div>

                <div class="col-12">
                    <button type="submit" id="btnEnviarContacto" class="btn btn-primary ka-submit-button">
                        <i class="bi bi-send-fill"></i>
                        Enviar mensaje
                    </button>
                </div>
            </div>
        }
    </div>
</div>