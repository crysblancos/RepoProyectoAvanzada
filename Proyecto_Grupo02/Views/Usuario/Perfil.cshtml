
@{
    ViewBag.Title = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-title">
    <h3>Mi perfil</h3>

    <p class="page-subtitle">
        Consulta y actualiza la información de tu cuenta.
    </p>
</div>

<section class="section">

    <div class="ka-profile-layout">

        
        <div class="ka-profile-summary">

            <div class="ka-profile-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <h4>Nombre del cliente</h4>

            <span>Cliente KA Fashion</span>

            <div class="ka-profile-status">
                <i class="bi bi-check-circle-fill"></i>
                Cuenta activa
            </div>

            <a href="@Url.Action("Index", "Home")"
               class="ka-profile-logout">

                <i class="bi bi-box-arrow-right"></i>
                Cerrar sesión

            </a>

        </div>


        <div class="ka-form-container">

            <div class="ka-form-introduction">

                <span class="ka-module-label">
                    Información personal
                </span>

                <h4>Editar perfil</h4>

                <p>
                    Actualiza los datos asociados a tu cuenta.
                </p>
            </div>


            <form id="formPerfil"
                  action="#"
                  novalidate>

                <div class="row">

                    <div class="col-md-4 mb-4">

                        <label for="perfilNombre"
                               class="form-label">
                            Nombre *
                        </label>

                        <input type="text"
                               id="perfilNombre"
                               class="form-control ka-form-control"
                               value="Nombre"
                               required />

                        <div class="invalid-feedback">
                            Ingrese el nombre.
                        </div>
                    </div>


                    <div class="col-md-4 mb-4">

                        <label for="perfilApellido1"
                               class="form-label">
                            Primer apellido
                        </label>

                        <input type="text"
                               id="perfilApellido1"
                               class="form-control ka-form-control"
                               value="Apellido" />
                    </div>


                    <div class="col-md-4 mb-4">

                        <label for="perfilApellido2"
                               class="form-label">
                            Segundo apellido
                        </label>

                        <input type="text"
                               id="perfilApellido2"
                               class="form-control ka-form-control" />
                    </div>


                    <div class="col-md-6 mb-4">

                        <label for="perfilCorreo"
                               class="form-label">
                            Correo electrónico *
                        </label>

                        <input type="email"
                               id="perfilCorreo"
                               class="form-control ka-form-control"
                               value="correo@ejemplo.com"
                               required />

                        <div class="invalid-feedback">
                            Ingrese un correo válido.
                        </div>
                    </div>


                    <div class="col-md-6 mb-4">

                        <label for="perfilTelefono"
                               class="form-label">
                            Teléfono
                        </label>

                        <input type="text"
                               id="perfilTelefono"
                               class="form-control ka-form-control"
                               value="8888-8888" />
                    </div>


                    <div class="col-12">

                        <hr class="ka-form-divider" />
                    </div>


                    <div class="col-md-6 mb-4">

                        <label for="perfilContrasenna"
                               class="form-label">
                            Nueva contraseña
                        </label>

                        <input type="password"
                               id="perfilContrasenna"
                               class="form-control ka-form-control" />
                    </div>


                    <div class="col-md-6 mb-4">

                        <label for="perfilConfirmar"
                               class="form-label">
                            Confirmar contraseña
                        </label>

                        <input type="password"
                               id="perfilConfirmar"
                               class="form-control ka-form-control" />

                        <div class="invalid-feedback"
                             id="mensajeContrasenna">

                            Las contraseñas no coinciden.

                        </div>
                    </div>


                    <div class="col-12">

                        <button type="button"
                                id="btnGuardarPerfil"
                                class="btn btn-primary ka-submit-button">
                            <i class="bi bi-floppy-fill"></i>
                            Guardar cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>


