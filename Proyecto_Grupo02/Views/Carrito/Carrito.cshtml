@model Proyecto_Grupo02.Models.CarritoViewModel
@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-title">
    <h3>Carrito de compras</h3>
    <p class="page-subtitle">Revisa los productos seleccionados antes de continuar con el pedido.</p>
</div>

<section class="section">

    <div class="ka-checkout-steps">
        <div class="ka-checkout-step active"><span>1</span><strong>Carrito</strong></div>
        <div class="ka-checkout-line"></div>
        <div class="ka-checkout-step"><span>2</span><strong>Datos del pedido</strong></div>
        <div class="ka-checkout-line"></div>
        <div class="ka-checkout-step"><span>3</span><strong>Confirmación</strong></div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="ka-module-card">
                <div class="ka-module-header">
                    <div>
                        <span class="ka-module-label">Productos seleccionados</span>
                        <h4>Tu carrito</h4>
                    </div>
                    <span class="ka-count-badge">
                        @(Model.Items.Sum(i => i.Cantidad)) artículo@(Model.Items.Sum(i => i.Cantidad) == 1 ? "" : "s")
                    </span>
                </div>

                @if (Model.Items.Count == 0)
                {
                    <div class="ka-empty-cart">
                        <i class="bi bi-cart-x"></i>
                        <h5>Tu carrito está vacío</h5>
                        <p>Agrega productos para continuar con tu compra.</p>
                        <a href="@Url.Action("Producto", "Producto")" class="btn btn-primary">Ver productos</a>
                    </div>
                }
                else
                {
                    <div id="listaCarrito">
                        @foreach (var item in Model.Items)
                        {
                            <div class="ka-cart-item">
                                <div class="ka-cart-image">
                                    <img src="~/Content/images/@item.Imagen" alt="@item.Nombre" />
                                </div>

                                <div class="ka-cart-information">
                                    <h5>@item.Nombre</h5>
                                    <div class="ka-cart-attributes">
                                        <span><strong>Talla:</strong> @item.Talla</span>
                                        <span><strong>Color:</strong> @item.Color</span>
                                    </div>
                                    <strong class="ka-cart-price">@item.Precio.ToString("₡#,##0.00")</strong>
                                </div>

                                <div class="ka-cart-actions">
                                    @using (Html.BeginForm("ActualizarCantidad", "Carrito", FormMethod.Post, new { @class = "ka-quantity-control" }))
                                    {
                                        @Html.Hidden("idDetalleCarrito", item.IdDetalleCarrito)
                                        <input type="number" name="cantidad" value="@item.Cantidad" min="1" class="cantidad-producto" style="width:60px" />
                                        <button type="submit" class="btn-cantidad" title="Actualizar cantidad">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    }

                                    @using (Html.BeginForm("Eliminar", "Carrito", FormMethod.Post))
                                    {
                                        @Html.Hidden("idDetalleCarrito", item.IdDetalleCarrito)
                                        <button type="submit" class="ka-delete-button" title="Eliminar producto">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <a href="@Url.Action("Producto", "Producto")" class="ka-continue-shopping">
                    <i class="bi bi-arrow-left"></i>
                    Continuar comprando
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="ka-order-summary">
                <span class="ka-module-label">Resumen</span>
                <h4>Resumen del pedido</h4>

                <div class="ka-summary-row">
                    <span>Subtotal</span>
                    <strong>@Model.Subtotal.ToString("₡#,##0.00")</strong>
                </div>

                <div class="ka-summary-row">
                    <span>Entrega estimada</span>
                    <strong>@(Model.Items.Count > 0 ? Model.CostoEntrega.ToString("₡#,##0.00") : "₡0,00")</strong>
                </div>

                <div class="ka-summary-divider"></div>

                <div class="ka-summary-row ka-summary-total">
                    <span>Total</span>
                    <strong>@Model.Total.ToString("₡#,##0.00")</strong>
                </div>

                <button type="button" class="btn btn-primary ka-full-button" id="btnContinuarPedido" @(Model.Items.Count == 0 ? "disabled" : "")>
                    Continuar con el pedido
                    <i class="bi bi-arrow-right"></i>
                </button>

                <div class="ka-safe-purchase">
                    <i class="bi bi-shield-check"></i>
                    <span>Tus datos se utilizarán únicamente para procesar el pedido.</span>
                </div>
            </div>
        </div>
    </div>
</section>