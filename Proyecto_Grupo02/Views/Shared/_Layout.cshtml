<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProyectoKafashion - Grupo02</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/bootstrap.css">
    <link rel="stylesheet" href="~/Content/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/Content/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/app.css">
    <link rel="stylesheet" href="~/Content/ka-fashion.css">
</head>

<body>
    <div id="app">
        <div id="sidebar" class="active">
            <div class="sidebar-wrapper active">
                <div class="sidebar-header">
                    <div class="d-flex justify-content-between">
                        <div class="logo">
                            <a href="@Url.Action("Principal", "Home")">
                                <img src="~/Content/images/KA Fashion.png"
                                     alt="Logo KA Fashion">
                            </a>
                        </div>
                        <div class="toggler">
                            <a href="#" class="sidebar-hide d-xl-none d-block"><i class="bi bi-x bi-middle"></i></a>
                        </div>
                    </div>
                </div>
                <div class="sidebar-menu">
                    <ul class="menu">

                        <li class="sidebar-item">
                            <a href="@Url.Action("Principal", "Home")" class="sidebar-link">
                                <i class="bi bi-house-door-fill"></i>
                                <span>Principal</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a href="@Url.Action("Producto", "Producto")"
                               class="sidebar-link">

                                <i class="bi bi-bag-fill"></i>
                                <span>Productos</span>

                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="@Url.Action("Carrito", "Carrito")"
                               class="sidebar-link">

                                <i class="bi bi-cart-fill"></i>
                                <span>Carrito</span>

                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a href="@Url.Action("MisPedidos", "Pedido")"
                               class="sidebar-link">

                                <i class="bi bi-receipt"></i>
                                <span>Mis pedidos</span>

                            </a>
                        </li>


                        <li class="sidebar-item">
                            <a href="@Url.Action("PersonalShopper", "PersonalShopper")"
                               class="sidebar-link">

                                <i class="bi bi-person-badge-fill"></i>
                                <span>Personal Shopper</span>
                            </a>
                        </li>


                        <li class="sidebar-item">

                            <a href="@Url.Action("Contacto", "Contacto")"
                               class="sidebar-link">

                                <i class="bi bi-chat-dots-fill"></i>
                                <span>Contacto</span>
                            </a>
                        </li>


                        <li class="sidebar-item">

                            <a href="@Url.Action("Perfil", "Usuario")"
                               class="sidebar-link">

                                <i class="bi bi-person-circle"></i>
                                <span>Mi perfil</span>
                            </a>
                        </li>

                    </ul>
                </div>
                <button class="sidebar-toggler btn x"><i data-feather="x"></i></button>
            </div>
        </div>
        <div id="main">
            <header class="ka-internal-header mb-3">

                <a href="#"
                   class="burger-btn d-block d-xl-none">
                    <i class="bi bi-justify fs-3"></i>
                </a>
                <div class="ka-header-actions">

                    @if (ViewBag.Title == "Principal")
                    {
                        <a href="@Url.Action("Perfil", "Usuario")"
                           class="ka-header-profile">
                            <span class="ka-header-profile-icon">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <span class="ka-header-profile-text">
                                @Session["NombreUsuario"]
                            </span>
                        </a>
                    }

                    @if (ViewBag.Title == "Productos")
                    {
                        <a href="@Url.Action("Carrito", "Carrito")"
                           class="ka-header-cart">
                            <i class="bi bi-cart-fill"></i>
                            <span class="ka-header-cart-text">
                                Mi carrito
                            </span>
                            <span class="ka-header-cart-count">
                                2
                            </span>
                        </a>
                    }
                </div>
            </header>

            <div class="page-heading">

                @RenderBody()

            </div>

            <footer>
                <div class="footer clearfix mb-0 text-muted">
                    <div class="float-start">
                        <p>2026 &copy; Ka Fashion</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/Scripts/perfect-scrollbar.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/main.js"></script>
    <script src="~/Scripts/carrito.js"></script>
    <script src="~/Scripts/contacto.js"></script>
    <script src="~/Scripts/personal-shopper.js"></script>
    <script src="~/Scripts/perfil.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>

</html>
