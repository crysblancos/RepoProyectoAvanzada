@model List<Proyecto_Grupo02.Models.ProductoListItemViewModel>
@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-title mb-4">
    <div class="row">
        <div class="col-12">
            <h3>Productos</h3>
            <p>Descubre nuestra colección de productos disponibles.</p>
        </div>
    </div>
</div>

<section class="section">
    <div class="row">
        @if (Model == null || Model.Count == 0)
        {
            <div class="col-12">
                <p>No hay productos disponibles en este momento.</p>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 col-12 mb-4">
                    <div class="product-card">
                        <div class="product-image-container">
                            <img src="~/Content/images/@item.Imagen" class="product-image" alt="@item.Nombre">
                        </div>
                        <div class="product-card-body">
                            <h5 class="product-name">@item.Nombre</h5>
                            <p class="product-price">@item.Precio.ToString("₡#,##0.00")</p>
                            <div class="product-card-footer">
                                <a href="@Url.Action("DetalleProducto", "Producto", new { id = item.IdProducto })"
                                   class="product-button">
                                    Ver artículo
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>